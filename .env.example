# Server (mini convention: project#2 API = 4110)
PORT=4110

# Ollama (OpenAI-compatible endpoint)
OLLAMA_URL=http://localhost:11434/v1
MODEL=gemma4:12b

# Data locations (on the Mini, point these at ~/server/data/llm-gateway)
DOCS_DIR=./data/docs
PROMPTS_DIR=./data/prompts

# Prompt file to use by default (relative to PROMPTS_DIR)
DEFAULT_PROMPT=qa.txt

# Database (MySQL). Host port follows the mini convention: project#2 RDB = 4120 (stg 4170)
DB_NAME=llm_gateway
DB_USER=app
DB_PASSWORD=
DB_ROOT_PASSWORD=
DATABASE_URL=mysql://app:password@localhost:4120/llm_gateway

# Auth (better-auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4110

# Google OAuth (enabled later; leave empty until social login is added)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
